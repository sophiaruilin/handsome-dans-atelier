# Copy this file to hw4/.env and fill in your own key. Never commit the real .env.
# The back end also looks for .env in hw4/backend/ and in the folder above hw4/.

# Required: Portkey API key (the agent uses gpt-6-astra through Portkey's OpenAI-compatible gateway)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional (defaults shown)
OPENAI_MODEL=gpt-6-astra
COOKIE_SECURE=false
PYDANTIC_AI_NO_BANNER=1
